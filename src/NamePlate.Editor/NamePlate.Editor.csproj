<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NamePlate.Editor</RootNamespace>
    <AssemblyName>NamePlate.Editor</AssemblyName>
    <!-- Drawn by scripts/make_app_icon.py -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      One exe, shipped as "Name Plate.exe" in the SPT folder itself (scripts/package.ps1):
        dotnet publish -c Release -o dist/editor
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the game's icons out of resources.assets -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <!-- Unity class layouts for AssetsTools; the game's files don't carry their own -->
    <EmbeddedResource Include="Assets\classdata.tpk" LogicalName="classdata.tpk" />
    <!-- The window icon (title bar, taskbar) -->
    <Resource Include="Assets\app.ico" />
    <!-- The header logo, the same picture -->
    <Resource Include="Assets\logo.png" />
    <!-- The bot look generator, shared with the plugin so the preview matches the game -->
    <Compile Include="..\Shared\BotLooks.cs" Link="Shared\BotLooks.cs" />
    <Compile Include="..\Shared\BotTags.cs" Link="Shared\BotTags.cs" />
  </ItemGroup>

</Project>
