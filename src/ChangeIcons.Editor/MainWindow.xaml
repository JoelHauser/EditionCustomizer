<Window x:Class="ChangeIcons.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChangeIcons.Editor"
        Title="ChangeIcons Editor" Width="1280" Height="840" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
            <DockPanel Height="62">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="Logo" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CHANGE ICONS" FontFamily="{StaticResource Heading}" FontWeight="Bold" FontSize="20"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" Height="62">
                        <RadioButton x:Name="IconsTab" Style="{StaticResource Tab}" Content="ICONS" GroupName="Page" IsChecked="True" />
                        <RadioButton x:Name="BotsTab" Style="{StaticResource Tab}" Content="BOTS" GroupName="Page" />
                        <RadioButton x:Name="ProfileTab" Style="{StaticResource Tab}" Content="PROFILE" GroupName="Page" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button x:Name="SptButton" Style="{StaticResource GhostBtn}" Margin="0,0,14,0"/>
                    <Button x:Name="SaveButton" Style="{StaticResource AccentBtn}" Content="SAVE" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ ICONS -->
        <Grid x:Name="IconsPage" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,18,0,14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="YOUR ICONS" Margin="22,0,0,10" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="14,10,14,0">
                        <Button x:Name="NewButton" Content="+ NEW" Margin="0,0,6,0" ToolTip="A new icon of your own" />
                        <Button x:Name="CopyButton" Content="COPY" Margin="0,0,6,0" ToolTip="A new icon that starts as a copy of this one" />
                        <Button x:Name="RemoveButton" Content="REMOVE" />
                    </UniformGrid>
                    <ListBox x:Name="IconList" Style="{StaticResource CleanList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="5" Background="{StaticResource IconTileBrush}">
                                        <Image Source="{Binding Thumbnail}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <local:StyledName Grid.Column="1" Text="{Binding DisplayName}" Look="{Binding Look}" FontSize="15"
                                                      Margin="12,0,6,0" VerticalAlignment="Center" ClipToBounds="True" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tag}" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Live preview, laid out like the places the game shows it -->
                <Border Margin="26,22,26,0" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16191B" Offset="0" />
                            <GradientStop Color="#0B0C0D" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="MAIN MENU" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="PreviewIcon" Width="34" Height="34" VerticalAlignment="Bottom" Margin="0,0,12,6" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel>
                                    <TextBlock Text="YOUR MAIN CHARACTER" Style="{StaticResource Caption}" FontSize="11" />
                                    <local:StyledName x:Name="PreviewName" FontSize="32" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" Text="CHAT" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Image x:Name="ChatIcon" Width="17" Height="17" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <local:StyledName x:Name="ChatName" FontSize="15" FontFamily="Segoe UI" />
                                <TextBlock Text=":  ready at dorms?" Foreground="#AEB4B8" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.55">
                                <Image x:Name="ChatIcon2" Width="17" Height="17" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <local:StyledName x:Name="ChatName2" FontSize="15" FontFamily="Segoe UI" />
                                <TextBlock Text=":  gg" Foreground="#AEB4B8" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" Text="SETTINGS · PROFILE ICON" Margin="0,0,0,14" />
                            <Border Background="#1E2123" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,7">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="DropdownIcon" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <local:StyledName x:Name="DropdownName" FontSize="14" FontFamily="Segoe UI" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="DropdownNote" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Margin="26,16,10,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">

                        <!-- NAME -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="NAME" />
                                    <TextBox x:Name="NameBox" MaxWidth="460" HorizontalAlignment="Left" Width="460" />
                                    <TextBlock x:Name="NameHint" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="What the settings dropdown calls this icon. Your nickname itself stays as it is." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="SlotText" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- NAME COLOR -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="GameColorButton" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="USE THE GAME'S COLOR" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="NICKNAME COLOR" />
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="SolidMode" Style="{StaticResource Segment}" Content="ONE COLOR" GroupName="Mode" />
                                    <RadioButton x:Name="GradientMode" Style="{StaticResource Segment}" Content="GRADIENT" GroupName="Mode" />
                                    <RadioButton x:Name="LettersMode" Style="{StaticResource Segment}" Content="PER LETTER" GroupName="Mode" />
                                </StackPanel>

                                <WrapPanel x:Name="ColorChips" />
                                <TextBlock x:Name="ChipHint" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Click a color to change it. Right-click to move or remove it." />

                                <StackPanel x:Name="MultiPanel">
                                    <TextBlock Style="{StaticResource Caption}" Text="PRESETS" Margin="0,16,0,8" />
                                    <WrapPanel x:Name="PresetPanel" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <ToggleButton x:Name="AnimateSwitch" Style="{StaticResource Switch}" Content="Animate" />
                                        <Slider x:Name="SpeedSlider" Width="220" Minimum="0.05" Maximum="2" Value="0.4" Margin="20,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SpeedText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Width="80" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ICON -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="ICON" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <Border Width="140" Height="140" CornerRadius="8" Background="{StaticResource IconTileBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Image x:Name="BigIcon" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock x:Name="IconSourceText" Style="{StaticResource Hint}" Margin="0,8,12,0" />
                                        <ToggleButton x:Name="TintSwitch" Style="{StaticResource Switch}" Content="Recolor" Margin="0,14,0,0" />
                                        <Button x:Name="TintChip" Width="140" Height="30" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="0" />
                                        <Button x:Name="OwnIconButton" Content="GAME'S OWN ICON" Margin="0,10,0,0" Width="140" HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <DockPanel Grid.Column="1">
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <RadioButton x:Name="LibraryTab" Style="{StaticResource Segment}" Content="LIBRARY" GroupName="Gallery" IsChecked="True" />
                                            <RadioButton x:Name="MemberTab" Style="{StaticResource Segment}" Content="MEMBER ICONS" GroupName="Gallery" />
                                            <RadioButton x:Name="GameTab" Style="{StaticResource Segment}" Content="ALL GAME ICONS" GroupName="Gallery" />
                                            <RadioButton x:Name="MineTab" Style="{StaticResource Segment}" Content="YOUR IMAGES" GroupName="Gallery" />
                                        </WrapPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="IMPORT IMAGE..." Margin="10,0,0,0" />
                                            <TextBox x:Name="SearchBox" Tag="Search icons by name" FontSize="13" />
                                        </DockPanel>
                                        <DockPanel x:Name="GameBar" DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Button x:Name="RereadButton" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="READ AGAIN FROM THE GAME" />
                                            <ToggleButton x:Name="LargeSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Big images" Margin="0,0,16,0" />
                                            <TextBlock x:Name="GameCountText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ListBox x:Name="Gallery" Style="{StaticResource Gallery}" Height="316" />
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================ BOTS -->
        <Grid x:Name="BotsPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Margin="26,22,10,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="PMC BOTS" />
                            <ToggleButton x:Name="BotsSwitch" Style="{StaticResource Switch}" Content="Give PMC bots their own icon and name colors" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="Share of PMCs" Width="150" VerticalAlignment="Center" />
                                <Slider x:Name="ShareSlider" Width="260" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShareText" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                       Text="Each bot's look comes from its name, so a name looks the same in every raid. It shows on the death screen (icon and colors) and in the kill list after a raid (colors). Works with Bot Callsigns Reloaded and Realistic PMC Names: they only decide which names bots get." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="NAME COLORS THEY CAN GET" />
                            <WrapPanel>
                                <ToggleButton x:Name="BotSolid" Style="{StaticResource ChipToggle}" Content="ONE COLOR" />
                                <ToggleButton x:Name="BotGradient" Style="{StaticResource ChipToggle}" Content="GRADIENT" />
                                <ToggleButton x:Name="BotLetters" Style="{StaticResource ChipToggle}" Content="PER LETTER" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="PRESETS" Margin="0,12,0,8" />
                            <WrapPanel x:Name="BotPresetPanel" />
                            <ToggleButton x:Name="BotRandomColors" Style="{StaticResource Switch}" Content="Make up colors too, not only presets" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="Animated names" Width="150" VerticalAlignment="Center" />
                                <Slider x:Name="BotAnimateSlider" Width="260" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                                <TextBlock x:Name="BotAnimateText" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Fastest animation" Width="150" VerticalAlignment="Center" />
                                <Slider x:Name="BotSpeedSlider" Width="260" Minimum="0.1" Maximum="2" VerticalAlignment="Center" />
                                <TextBlock x:Name="BotSpeedText" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="BotIconsAll" Style="{StaticResource GhostBtn}" Content="ALL" />
                                    <Button x:Name="BotIconsNone" Style="{StaticResource GhostBtn}" Content="NONE" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="ICONS THEY CAN GET" />
                            </DockPanel>
                            <TextBlock x:Name="BotIconCount" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                            <ListBox x:Name="BotIconGallery" Style="{StaticResource Gallery}" SelectionMode="Multiple" Height="236" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="BOTS WITH A FIXED LOOK" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Give a particular bot name one of your icons: its picture and its name colors. The name has to match (capitals don't matter)." />
                            <StackPanel x:Name="NamedPanel" />
                            <Button x:Name="AddNamedButton" Content="+ ADD A NAME" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="22,22,22,16">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="DEATH SCREEN" Margin="0,0,0,8" />
                    <Border DockPanel.Dock="Top" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1C1414" Offset="0" />
                                <GradientStop Color="#0B0C0D" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="KILLED BY" Style="{StaticResource Caption}" FontSize="11" Foreground="#B0655A" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Image x:Name="KillerIcon" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <local:StyledName x:Name="KillerName" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="KillerNote" Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <TextBox DockPanel.Dock="Top" x:Name="TryNameBox" Tag="Try any bot name" Margin="0,12,0,0" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,18,0,4">
                        <Button DockPanel.Dock="Right" x:Name="ShuffleButton" Style="{StaticResource GhostBtn}" Content="SHUFFLE" />
                        <TextBlock Style="{StaticResource Caption}" Text="PMC BOTS IN YOUR RAIDS" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="NameSourceText" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <ListBox x:Name="BotSampleList" Style="{StaticResource CleanList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="34">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" />
                                    <Image Source="{Binding Thumbnail}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <local:StyledName Text="{Binding DisplayName}" Look="{Binding Look}" FontSize="16" VerticalAlignment="Center" ClipToBounds="True" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================================================ PROFILE -->
        <Grid x:Name="ProfilePage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,18,0,14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="CHARACTERS" Margin="22,0,0,10" />
                    <ListBox x:Name="ProfileList" Style="{StaticResource CleanList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Thumbnail}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <local:StyledName Text="{Binding Title}" Look="{Binding Look}" FontSize="16" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="26,22,10,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">
                    <Border x:Name="ServerPill" CornerRadius="16" Padding="14,7" HorizontalAlignment="Left" Margin="0,0,0,16" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ServerText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ICONS THIS CHARACTER HAS" />
                            <WrapPanel x:Name="OwnedPanel" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="SHOWN BY YOUR NAME" />
                            <WrapPanel x:Name="ShownPanel" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyProfileButton" Style="{StaticResource AccentBtn}" Content="SAVE TO CHARACTER" />
                        <TextBlock x:Name="ProfileNote" Style="{StaticResource Hint}" Margin="16,0,0,0" MaxWidth="560" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Busy overlay while reading the game's files -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#E00B0C0D" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="READING THE GAME'S ICONS" FontFamily="{StaticResource Heading}" FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="BusyText" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
